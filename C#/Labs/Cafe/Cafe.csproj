<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Cafeshka</AssemblyName>
    <RootNamespace>Cafeshka</RootNamespace>
    <ApplicationIcon>TeaCup_Archigraphs.ico</ApplicationIcon>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\buttonOrder.png" LogicalName="Cafeshka.Assets.buttonOrder.png" />
<EmbeddedResource Include="Assets\FormCafe.ico" LogicalName="Cafeshka.Assets.FormCafe.ico" />
  </ItemGroup>
</Project>
